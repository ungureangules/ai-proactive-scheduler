# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/scheduler
SECRET_KEY=generate_a_secure_random_key_here
ALGORITHM=HS256

# AI Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here

# Messaging Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=your_twilio_whatsapp_number_here

# Google Calendar API Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/businesses/google-auth-callback

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
