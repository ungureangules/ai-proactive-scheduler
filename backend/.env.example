# Backend Configuration
DATABASE_URL=postgresql://postgres:postgres@db:5432/scheduler
# Required. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Required. Encrypts stored Google tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing it later disconnects every Google Calendar.
ENCRYPTION_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Where the dashboard runs (CORS + redirect after Google sign-in)
FRONTEND_URL=http://localhost:3000
# Public URL of this API exactly as Twilio calls it (e.g. your ngrok URL in development).
# Used to verify Twilio webhook signatures.
PUBLIC_BASE_URL=http://localhost:8000

# AI Configuration (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Messaging Configuration (Twilio)
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886
# Approved WhatsApp template for proactive outreach (Content SID, "HX...").
# Variables: {{1}} client name, {{2}} business name, {{3}} days since last visit.
# Without it, outreach is sent as free-form text, which WhatsApp only delivers
# to clients who messaged you in the last 24 hours.
TWILIO_OUTREACH_CONTENT_SID=

# Google Calendar API Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/businesses/google-auth-callback

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Scheduling behaviour (optional)
OUTREACH_LOCAL_HOUR=10
OUTREACH_LEAD_DAYS=2
OUTREACH_COOLDOWN_DAYS=14
